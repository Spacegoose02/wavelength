<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the iPhone app's Info.plist by `tauri ios init` / `tauri ios build` (docs/IOS.md). -->
<plist version="1.0">
<dict>
  <!-- keep playing with the screen off and from the lock screen -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <!-- Navidrome, Plex or a Hub on the home network, and casting to speakers -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Wavelength connects to your music server and speakers on your home network.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_googlecast._tcp</string>
  </array>
  <!-- home servers are often plain http on the local network -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
</dict>
</plist>
