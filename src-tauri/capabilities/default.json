{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: allow HTTP to any self-hosted server the user configures",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*:*" },
        { "url": "http://**" },
        { "url": "https://*" },
        { "url": "https://*:*" },
        { "url": "https://**" }
      ]
    }
  ]
}
