{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wavelength",
  "mainBinaryName": "Wavelength",
  "version": "0.16.0",
  "identifier": "com.tonearm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wavelength",
        "width": 1320,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/offline/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
